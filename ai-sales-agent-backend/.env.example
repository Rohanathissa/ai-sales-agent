# Copy this file to .env and fill in your actual values.
# On CapRover, set these as app environment variables instead of a .env file.
# Leave PORT unset there so the image default (80) matches CapRover's container port.

PORT=3000

# PostgreSQL connection.
# CapRover one-click Postgres hostname is srv-captain--<app-name>
# (for example PGHOST=srv-captain--postgres).
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=ai_sales_agent

# Required for login. Use a long random value in production.
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Optional. The API starts without these; AI replies and WhatsApp need them.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# First deploy only, from the CapRover app terminal. This DROPS and recreates every table.
# node scripts/db-setup.js
